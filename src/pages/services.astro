      <SectionQuote />
      <section class="section_cta is-v2">
        <div class="padding-global">
          <div class="padding-section-large">
            <div class="container-medium">
              <div class="cta_content-wrapper">
                <div class="cta_content-heading">
                  <h2 class="heading-style-h1-semi-bold text-color-coal-dark">
                    Ready to get started?
                  </h2>
                </div>
                <div class="button-wrapper">
                  <ButtonIcon variant="base" text="Say hi" />
                </div>
