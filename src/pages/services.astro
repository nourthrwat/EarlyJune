---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ButtonIcon from '@/components/ButtonIcon.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import SectionQuote from '@/components/SectionQuote.astro'
---

<BaseLayout title="Services">
  <div class="page-wrapper">
    <Header />
    <div class="main-wrapper">
      <section class="section_hero-services">
        <div class="padding-global">
          <div class="padding-section-t7-84-b7-84">
            <div class="container-medium">
              <div class="section_hero-services-content">
                <div class="text-subheading">
                  services
                </div>
                <h1 class="h1-style-112px">
                  Your complete boutique agency, in the age of AI.
                </h1>
                <div class="max-width-medium">
                  <div class="body-text text-color-coal-dark">
                    Full-funnel, expert team members AI-powered deployments HIPAA and Fair Lending Compliance
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section_services">
        <div class="padding-global">
          <div class="padding-section-large">
            <div class="container-medium">
              <div class="section_services-content">
                <h2 class="heading-style-h1-large text-color-green-dark text-align-center text-weight-medium">
                  Early June 
                  <span class="text-weight-normal text-style-italic">
                    Services
                  </span>
                </h2>
                <div class="spacer-large"></div>
                <div class="section_services-cards-wrapper">
                  <div class="section_services-card">
                    <div class="section_services-card-front">
                      <div class="section_services-card-image-wrapper">
                        <img src="https://s3.amazonaws.com/webflow-prod-assets/6ab98d8daf6ccf6378b3dad6/6ab98d8daf6ccf6378b3db3b_image%2096.avif" alt="Performance Creative &amp; Production" loading="lazy" class="section_services-card-image" />
                      </div>
                      <div class="section_services-card-content">
                        <div class="text-subheading">
                          Service
                        </div>
                        <h3 class="section_services-card-title">
                          Performance Creative &amp; Production
                        </h3>
                      </div>
                    </div>
                    <div class="section_services-card-back">
                      <div>
                        <div class="section_services-text-wrapper">
                          <div>
                            Performance Reporting
                          </div>
                        </div>
                        <div class="section_services-text-wrapper">
                          <div>
                            AI-Assisted Web &amp; Engagement Analytics
                          </div>
                        </div>
                        <div class="section_services-text-wrapper">
                          <div>
                            AI-Assisted Tracking / Tagging
                          </div>
                        </div>
                        <div class="section_services-text-wrapper">
                          <div>
                            Attribution
                          </div>
                        </div>
                        <div class="section_services-text-wrapper">
                          <div>
                            ROI Analysis
                          </div>
                        </div>
                        <div class="section_services-text-wrapper">
                          <div>
                            Market &amp; Industry Reports
                          </div>
                        </div>
                        <div class="section_services-text-wrapper is-last">
                          <div>
                            Insights &amp; Recommendations
                          </div>
                        </div>
                      </div>
                      <div>
                        <div class="text-subheading">
                          Service
                        </div>
                        <h3 class="section_services-card-title">
                          Growth Marketing
                        </h3>
                      </div>
                    </div>
                  </div>
                  <div class="section_services-card is-blue-light">
                    <div class="section_services-card-front">
                      <div class="section_services-card-image-wrapper">
                        <img src="https://s3.amazonaws.com/webflow-prod-assets/6ab98d8daf6ccf6378b3dad6/6ab98d8daf6ccf6378b3db3c_image%2096%20(1).avif" alt="Growth Marketing" loading="lazy" class="section_services-card-image" />
