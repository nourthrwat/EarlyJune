---
import SanityImage from '../ui/SanityImage.astro'
import {pathFor} from '@/lib/links'
import type {CaseStudyCard} from '@/lib/types'

interface Props {
  study: CaseStudyCard
}

const {study} = Astro.props
const image = study.sliderImage?.desktop
---

<a class="cs-card" href={pathFor('caseStudy', study.slug)} style={study.brandColor ? `--brand: ${study.brandColor}` : undefined}>
  <div class="cs-card__media">
    <SanityImage image={image} alt={study.sliderImage?.alt ?? study.title} width={1100} aspect={4 / 3} sizes="(min-width: 768px) 34rem, 85vw" />
  </div>
  <div class="cs-card__body">
    {study.tags && study.tags.length > 0 && <p class="eyebrow">{study.tags.join(' · ')}</p>}
    <h3 class="heading-style-h4">{study.title}</h3>
    {study.description && <p class="text-muted">{study.description}</p>}
  </div>
</a>

<style>
  .cs-card {
    display: grid;
    gap: var(--space-4);
    text-decoration: none;
  }
  .cs-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-large);
    background: var(--brand, var(--border));
  }
  .cs-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .cs-card:hover .cs-card__media :global(img) {
    transform: scale(1.03);
  }
  .cs-card__body {
    display: grid;
    gap: var(--space-2);
  }
</style>
