---
import SanityImage from '../ui/SanityImage.astro'
import {pathFor} from '@/lib/links'
import type {PostCard} from '@/lib/types'

interface Props {
  post: PostCard
  featured?: boolean
}

const {post, featured = false} = Astro.props
---

<a class:list={['post-card', featured && 'post-card--featured']} href={pathFor('post', post.slug)}>
  <div class="post-card__media">
    <SanityImage
      image={post.image}
      alt={post.title}
      width={featured ? 1600 : 900}
      aspect={featured ? 16 / 9 : 3 / 2}
      sizes={featured ? '(min-width: 992px) 60vw, 100vw' : '(min-width: 992px) 33vw, 100vw'}
    />
  </div>
  <div class="post-card__body">
    <p class="eyebrow">
      {[post.category?.title, post.readTime].filter(Boolean).join(' · ')}
    </p>
    <h3 class={featured ? 'heading-style-h3' : 'heading-style-h4'}>{post.title}</h3>
    {post.summary && <p class="text-muted post-card__summary">{post.summary}</p>}
  </div>
</a>

<style>
  .post-card {
    display: grid;
    gap: var(--space-4);
    text-decoration: none;
  }
  .post-card__media {
    overflow: hidden;
    border-radius: var(--radius-medium);
    background: var(--border);
  }
  .post-card__media :global(img) {
    width: 100%;
    transition: transform 600ms var(--ease);
  }
  .post-card:hover .post-card__media :global(img) {
    transform: scale(1.03);
  }
  .post-card__body {
    display: grid;
    gap: var(--space-2);
  }
  .post-card__summary {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 992px) {
    .post-card--featured {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
      gap: var(--space-7);
    }
  }
</style>
