---
/** Responsive image from Sanity. Always use this instead of a raw <img>. */
import {urlFor, srcSet} from '@/lib/sanity'
import type {Image} from '@/lib/types'

interface Props {
  image?: Image | null
  alt?: string
  sizes?: string
  width?: number
  aspect?: number // width / height, e.g. 16/9. Crops using the hotspot.
  eager?: boolean
  class?: string
}

const {image, alt, sizes = '100vw', width = 1600, aspect, eager = false, class: className} = Astro.props
const hasAsset = Boolean(image && (image as {asset?: unknown}).asset)
const base = hasAsset ? urlFor(image!) : null
const src = base ? (aspect ? base.width(width).height(Math.round(width / aspect)) : base.width(width)).url() : null
const widths = [480, 768, 1200, 1600, 2000].filter((w) => w <= width * 1.25)
---

{
  src && (
    <img
      class={className}
      src={src}
      srcset={aspect ? undefined : srcSet(image!, widths)}
      sizes={sizes}
      alt={alt ?? image?.alt ?? ''}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  )
}
