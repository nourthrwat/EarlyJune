---
/**
 * Eyebrow + heading + intro used at the top of most blocks.
 * Heading level is decided by the page, not by the CMS (first block = h1).
 */
interface Props {
  eyebrow?: string | null
  heading?: string | null
  intro?: string | null
  level?: 'h1' | 'h2' | 'h3'
  align?: 'start' | 'center'
  size?: 'display' | 'h1' | 'h2'
}

const {eyebrow, heading, intro, level = 'h2', align = 'start', size = 'h2'} = Astro.props
const Tag = level
---

{
  (eyebrow || heading || intro) && (
    <div class:list={['section-heading', `section-heading--${align}`]}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {heading && <Tag class={`heading-style-${size}`}>{heading}</Tag>}
      {intro && <p class="text-size-medium text-muted section-heading__intro">{intro}</p>}
    </div>
  )
}

<style>
  .section-heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
    max-width: 48rem;
  }
  .section-heading--center {
    margin-inline: auto;
    text-align: center;
  }
  .section-heading__intro {
    max-width: 40rem;
  }
  .section-heading--center .section-heading__intro {
    margin-inline: auto;
  }
</style>
