---
/**
 * Button — the only way to render a button or CTA link.
 * Variants come from the `style` field on Sanity `link` objects.
 */
import {hrefFor, isExternal, type LinkValue} from '@/lib/links'

interface Props {
  link?: LinkValue | null
  href?: string
  label?: string
  variant?: 'primary' | 'secondary' | 'text'
}

const {link, href: hrefProp, label: labelProp, variant: variantProp} = Astro.props
const href = hrefProp ?? hrefFor(link)
const label = labelProp ?? link?.label
const variant = variantProp ?? link?.style ?? 'primary'
const external = isExternal(href)
---

{
  href && label && (
    <a
      class:list={['button', `button--${variant}`]}
      href={href}
      {...(external ? {target: '_blank', rel: 'noopener noreferrer'} : {})}
    >
      {label}
    </a>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--button-bg);
    font-family: var(--font-body);
    font-size: var(--fs-medium);
    line-height: var(--lh-tight);
    letter-spacing: -0.05rem;
    text-decoration: none;
    transition:
      transform var(--duration) var(--ease),
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  .button:hover {
    transform: translateY(-2px);
  }
  .button--primary {
    background: var(--button-bg);
    color: var(--button-text);
  }
  .button--secondary {
    background: transparent;
    color: var(--text);
    border-color: currentColor;
  }
  .button--secondary:hover {
    background: var(--button-bg);
    color: var(--button-text);
    border-color: var(--button-bg);
  }
  .button--text {
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .button--text:hover {
    transform: none;
    text-decoration-thickness: 2px;
  }
</style>
