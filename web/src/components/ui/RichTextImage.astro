---
import SanityImage from './SanityImage.astro'

const {node} = Astro.props as {node: {asset?: unknown; alt?: string; caption?: string}}
---

<figure class="rich-text-figure">
  <SanityImage image={node as never} alt={node.alt} sizes="(min-width: 48rem) 48rem, 100vw" width={1200} />
  {node.caption && <figcaption class="text-size-small text-muted">{node.caption}</figcaption>}
</figure>

<style>
  .rich-text-figure img {
    border-radius: var(--radius-medium);
  }
  figcaption {
    margin-top: var(--space-2);
  }
</style>
