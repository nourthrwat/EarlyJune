---
import {hrefFor} from '@/lib/links'
import type {SiteSettings} from '@/lib/types'

interface Props {
  settings: SiteSettings
}

const {settings} = Astro.props
const year = new Date().getFullYear()
---

<footer class="site-footer theme-coal padding-global padding-section-medium">
  <div class="container-large site-footer__inner">
    <div class="site-footer__brand">
      <p class="heading-style-h3">{settings?.siteName ?? 'Early June'}</p>
      {settings?.contactEmail && <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>}
    </div>

    {
      (settings?.footerLinks?.length ?? 0) > 0 && (
        <nav aria-label="Footer">
          <ul role="list" class="site-footer__links">
            {settings!.footerLinks!.map((link) => (
              <li>
                <a href={hrefFor(link)}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      (settings?.socialLinks?.length ?? 0) > 0 && (
        <ul role="list" class="site-footer__links">
          {settings!.socialLinks!.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {s.platform}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <p class="container-large text-size-small text-muted site-footer__legal">© {year} {settings?.siteName ?? 'Early June'}</p>
</footer>

<style>
  .site-footer__inner {
    display: grid;
    gap: var(--space-7);
  }
  .site-footer__brand {
    display: grid;
    gap: var(--space-3);
  }
  .site-footer__links {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    text-decoration: underline;
  }
  .site-footer__legal {
    margin-top: var(--space-8);
  }
  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
