---
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import SanityImage from '../ui/SanityImage.astro'
import type {Image} from '@/lib/types'

interface Props {
  eyebrow?: string
  heading?: string
  members?: {_id: string; name: string; jobTitle?: string; photo?: Image}[]
  theme?: string
  level?: 'h1' | 'h2'
}

const {eyebrow, heading, members = [], theme, level} = Astro.props
---

<Section theme={theme}>
  <SectionHeading eyebrow={eyebrow} heading={heading} level={level} />
  <ul class="team" role="list">
    {
      members.map((m) => (
        <li class="member">
          <div class="member__photo">
            <SanityImage image={m.photo} alt={m.name} width={600} aspect={4 / 5} sizes="(min-width: 992px) 25vw, 50vw" />
          </div>
          <h3 class="heading-style-h4">{m.name}</h3>
          {m.jobTitle && <p class="text-muted">{m.jobTitle}</p>}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-7) var(--space-5);
    padding: 0;
    list-style: none;
  }
  .member {
    display: grid;
    gap: var(--space-2);
  }
  .member__photo {
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-medium);
    background: var(--border);
  }
  .member__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 992px) {
    .team {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
