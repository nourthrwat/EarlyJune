---
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import PostCard from '../cards/PostCard.astro'
import type {PostCard as Card} from '@/lib/types'

interface Props {
  heading?: string
  posts?: Card[]
  limit?: number
  showFeatured?: boolean
  theme?: string
  level?: 'h1' | 'h2'
}

const {heading, posts = [], limit = 6, showFeatured = false, theme, level} = Astro.props
const featured = showFeatured ? posts.find((p) => p.featured) : undefined
const rest = posts.filter((p) => p !== featured)
const visible = limit > 0 ? rest.slice(0, limit) : rest
---

<Section theme={theme}>
  <SectionHeading heading={heading} level={level} />
  {featured && <PostCard post={featured} featured />}
  <ul class="posts" role="list">
    {
      visible.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .posts {
    display: grid;
    gap: var(--space-7) var(--space-5);
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 992px) {
    .posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
