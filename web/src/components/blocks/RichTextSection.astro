---
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import RichText from '../ui/RichText.astro'

interface Props {
  heading?: string
  body?: unknown[]
  width?: 'small' | 'medium'
  theme?: string
  level?: 'h1' | 'h2'
}

const {heading, body, width = 'small', theme, level} = Astro.props
---

<Section theme={theme} width={width}>
  <SectionHeading heading={heading} level={level} />
  <RichText value={body} />
</Section>
