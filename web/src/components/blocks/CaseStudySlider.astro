---
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import Button from '../ui/Button.astro'
import CaseStudyCard from '../cards/CaseStudyCard.astro'
import type {LinkValue} from '@/lib/links'
import type {CaseStudyCard as Card} from '@/lib/types'

interface Props {
  eyebrow?: string
  heading?: string
  caseStudies?: Card[]
  cta?: LinkValue
  theme?: string
  level?: 'h1' | 'h2'
}

const {eyebrow, heading, caseStudies = [], cta, theme, level} = Astro.props
---

<Section theme={theme}>
  <div class="slider__head">
    <SectionHeading eyebrow={eyebrow} heading={heading} level={level} />
    {cta && <Button link={cta} variant="secondary" />}
  </div>
  <ul class="slider" role="list">
    {
      caseStudies.map((study) => (
        <li class="slider__item">
          <CaseStudyCard study={study} />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .slider__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }
  .slider__head :global(.section-heading) {
    margin-bottom: 0;
  }
  /* CSS scroll-snap slider: no JS, works with touch, keyboard and trackpad */
  .slider {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85%, 34rem);
    gap: var(--space-5);
    margin: 0 calc(var(--padding-global) * -1);
    padding: 0 var(--padding-global) var(--space-4);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--padding-global);
    scrollbar-width: thin;
  }
  .slider__item {
    scroll-snap-align: start;
  }
</style>
