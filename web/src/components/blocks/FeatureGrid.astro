---
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import SanityImage from '../ui/SanityImage.astro'
import Button from '../ui/Button.astro'
import type {LinkValue} from '@/lib/links'
import type {Image} from '@/lib/types'

interface Props {
  eyebrow?: string
  heading?: string
  intro?: string
  items?: {_key: string; title: string; text?: string; icon?: Image; link?: LinkValue}[]
  columns?: 2 | 3 | 4
  theme?: string
  level?: 'h1' | 'h2'
}

const {eyebrow, heading, intro, items = [], columns = 3, theme, level} = Astro.props
---

<Section theme={theme}>
  <SectionHeading eyebrow={eyebrow} heading={heading} intro={intro} level={level} />
  <ul class="features" style={`--columns: ${columns}`} role="list">
    {
      items.map((item) => (
        <li class="feature">
          {item.icon && <SanityImage image={item.icon} width={96} sizes="48px" class="feature__icon" />}
          <h3 class="heading-style-h4">{item.title}</h3>
          {item.text && <p class="text-muted">{item.text}</p>}
          {item.link && <Button link={item.link} variant="text" />}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .features {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }
  .feature {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .feature :global(.feature__icon) {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }
  @media (min-width: 768px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 992px) {
    .features {
      grid-template-columns: repeat(var(--columns), 1fr);
    }
  }
</style>
