---
/**
 * Renders a page's `pageBuilder` array.
 * REGISTRY: every Sanity block type maps to exactly one component here.
 * Adding a block? See "Adding a new block" in docs/components.md.
 */
import Hero from './Hero.astro'
import SplitMedia from './SplitMedia.astro'
import FeatureGrid from './FeatureGrid.astro'
import CaseStudySlider from './CaseStudySlider.astro'
import LogoStrip from './LogoStrip.astro'
import TeamGrid from './TeamGrid.astro'
import PostGrid from './PostGrid.astro'
import FaqList from './FaqList.astro'
import RichTextSection from './RichTextSection.astro'
import CtaBanner from './CtaBanner.astro'
import type {Block} from '@/lib/types'

interface Props {
  blocks?: Block[] | null
}

const REGISTRY: Record<string, (props: any) => any> = {
  hero: Hero,
  splitMedia: SplitMedia,
  featureGrid: FeatureGrid,
  caseStudySlider: CaseStudySlider,
  logoStrip: LogoStrip,
  teamGrid: TeamGrid,
  postGrid: PostGrid,
  faqList: FaqList,
  richTextSection: RichTextSection,
  ctaBanner: CtaBanner,
}

const {blocks} = Astro.props
const list = Array.isArray(blocks) ? blocks : []
// The first block that renders a heading gets the page's single <h1>
const firstHeadingIndex = list.findIndex((b) => typeof b.heading === 'string' && b.heading)
---

{
  list.map((block, index) => {
    const Component = REGISTRY[block._type]
    if (!Component) {
      if (import.meta.env.DEV) console.warn(`[PageBuilder] No component for block type "${block._type}"`)
      return null
    }
    return <Component {...block} level={index === firstHeadingIndex ? 'h1' : 'h2'} />
  })
}
