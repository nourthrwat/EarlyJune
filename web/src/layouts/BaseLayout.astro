---
/**
 * Every page uses this layout. It owns <head>: title, description, canonical,
 * Open Graph and robots. Pages pass the `seo` object resolved in GROQ.
 */
import '@/styles/global.css'
import SiteHeader from '@/components/SiteHeader.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import {sanityFetch, urlFor} from '@/lib/sanity'
import {SITE_SETTINGS_QUERY} from '@/lib/queries'
import type {Seo, SiteSettings} from '@/lib/types'

interface Props {
  seo?: Seo | null
  fallbackTitle?: string
  type?: 'website' | 'article'
}

const {seo, fallbackTitle, type = 'website'} = Astro.props
const settings = await sanityFetch<SiteSettings>(SITE_SETTINGS_QUERY)

const siteName = settings?.siteName ?? 'Early June'
const pageTitle = seo?.title ?? fallbackTitle
const title = pageTitle && pageTitle !== siteName ? `${pageTitle} | ${siteName}` : siteName
const description = seo?.description ?? settings?.defaultSeo?.description ?? undefined
const site = settings?.siteUrl ?? Astro.site?.toString() ?? ''
// Static builds report paths like "/about-us.html" or "/index.html"; canonical URLs match the live Webflow URLs
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/'
const canonical = new URL(cleanPath, site || Astro.url).toString()
const ogImage = seo?.image ? urlFor(seo.image).width(1200).height(630).fit('crop').url() : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {seo?.noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle ?? siteName} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <SiteHeader settings={settings} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter settings={settings} />
  </body>
</html>
