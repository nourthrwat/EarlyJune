---
/** Blog post template. Webflow URL: /post/<slug> */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/ui/Section.astro'
import SanityImage from '@/components/ui/SanityImage.astro'
import RichText from '@/components/ui/RichText.astro'
import PostCard from '@/components/cards/PostCard.astro'
import {sanityFetch} from '@/lib/sanity'
import {POST_SLUGS_QUERY, POST_QUERY} from '@/lib/queries'
import {pathFor} from '@/lib/links'
import type {Image, PostCard as Card, Seo} from '@/lib/types'

export async function getStaticPaths() {
  const slugs = (await sanityFetch<string[] | null>(POST_SLUGS_QUERY)) ?? []
  return slugs.map((slug) => ({params: {slug}}))
}

type Post = {
  title: string
  summary?: string
  readTime?: string
  publishedAt?: string
  body?: unknown[]
  mainImage?: Image
  category?: {title: string; slug: string} | null
  seo: Seo
  related?: Card[]
}

const post = await sanityFetch<Post | null>(POST_QUERY, {slug: Astro.params.slug})
if (!post) return Astro.redirect('/404')

const date = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric'})
  : null
---

<BaseLayout seo={post.seo} fallbackTitle={post.title} type="article">
  <article>
    <Section width="medium" spacing="large">
      <header class="post-header">
        <p class="eyebrow">
          {post.category && <a href={pathFor('blogCategory', post.category.slug)}>{post.category.title}</a>}
          {[date, post.readTime].filter(Boolean).map((s) => <span> · {s}</span>)}
        </p>
        <h1 class="heading-style-h1">{post.title}</h1>
        {post.summary && <p class="text-size-large text-muted">{post.summary}</p>}
      </header>
      {
        post.mainImage && (
          <div class="post-image">
            <SanityImage image={post.mainImage} eager sizes="(min-width: 84rem) 84rem, 100vw" />
          </div>
        )
      }
    </Section>
    <Section width="small" spacing="none" class="post-body">
      <RichText value={post.body} />
    </Section>
  </article>

  {
    post.related && post.related.length > 0 && (
      <Section theme="ivory">
        <h2 class="heading-style-h3 related-title">Related posts</h2>
        <ul class="related" role="list">
          {post.related.map((p) => (
            <li>
              <PostCard post={p} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</BaseLayout>

<style>
  .post-header {
    display: grid;
    gap: var(--space-5);
    max-width: 56rem;
  }
  .post-image {
    margin-top: var(--space-8);
  }
  .post-image :global(img) {
    width: 100%;
    border-radius: var(--radius-large);
  }
  :global(.post-body) {
    padding-bottom: var(--section-large);
  }
  .related-title {
    margin-bottom: var(--space-7);
  }
  .related {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 992px) {
    .related {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
