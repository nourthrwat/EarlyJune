---
/**
 * LIVING STYLE GUIDE — /styleguide (noindex)
 * Shows every token and every page-builder block with sample content.
 * When you add a token or block, add it here too. Humans and agents check this page
 * to see what already exists before building anything new.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/ui/Section.astro'
import Button from '@/components/ui/Button.astro'
import Hero from '@/components/blocks/Hero.astro'
import FeatureGrid from '@/components/blocks/FeatureGrid.astro'
import SplitMedia from '@/components/blocks/SplitMedia.astro'
import FaqList from '@/components/blocks/FaqList.astro'
import RichTextSection from '@/components/blocks/RichTextSection.astro'
import CtaBanner from '@/components/blocks/CtaBanner.astro'

const colors = [
  'coal-dark', 'coal', 'blue-deep', 'blue-dark', 'blue', 'blue-light', 'ivory', 'light', 'white',
  'green', 'green-light', 'green-dark', 'green-dark-2', 'gold', 'gold-light', 'gold-dark', 'red', 'rose', 'red-light',
]
const themes = ['light', 'ivory', 'coal', 'blue', 'gold', 'green']
const headings = [
  {cls: 'heading-style-display', token: '--fs-display'},
  {cls: 'heading-style-h1', token: '--fs-h1'},
  {cls: 'heading-style-h2', token: '--fs-h2'},
  {cls: 'heading-style-h3', token: '--fs-h3'},
  {cls: 'heading-style-h4', token: '--fs-h4'},
]
const texts = ['large', 'medium', 'regular', 'small', 'tiny']

const sampleLink = (label: string, style: 'primary' | 'secondary' | 'text' = 'primary') => ({
  label, style, linkType: 'external' as const, external: '#',
})
const sampleText = (text: string) => [
  {_type: 'block', _key: 'a', style: 'normal', markDefs: [], children: [{_type: 'span', _key: 'a1', text, marks: []}]},
]
---

<BaseLayout seo={{title: 'Style guide', noIndex: true}}>
  <Section spacing="large">
    <p class="eyebrow">Design system</p>
    <h1 class="heading-style-display">Style guide</h1>
    <p class="text-size-large text-muted sg-intro">
      Every token and block on the site. Build pages from these. Need something new? Follow
      docs/components.md — never style one-off.
    </p>
  </Section>

  <Section theme="ivory">
    <h2 class="heading-style-h3 sg-title">Colors</h2>
    <ul class="sg-swatches" role="list">
      {
        colors.map((c) => (
          <li>
            <span class="sg-swatch" style={`background: var(--color-${c})`} />
            <code>--color-{c}</code>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <h2 class="heading-style-h3 sg-title">Typography</h2>
    <div class="sg-stack">
      {
        headings.map((h) => (
          <div class="sg-row">
            <code>.{h.cls} · {h.token}</code>
            <p class={h.cls}>Built for brands that grow</p>
          </div>
        ))
      }
      {
        texts.map((t) => (
          <div class="sg-row">
            <code>.text-size-{t} · --fs-{t}</code>
            <p class={`text-size-${t}`}>Clear, concise copy in Work Sans for body text and UI.</p>
          </div>
        ))
      }
      <div class="sg-row"><code>.eyebrow</code><p class="eyebrow">Small label</p></div>
    </div>
  </Section>

  <Section theme="ivory">
    <h2 class="heading-style-h3 sg-title">Buttons</h2>
    <div class="sg-buttons">
      <Button link={sampleLink('Primary')} />
      <Button link={sampleLink('Secondary', 'secondary')} />
      <Button link={sampleLink('Text link', 'text')} />
    </div>
  </Section>

  <Section>
    <h2 class="heading-style-h3 sg-title">Themes</h2>
    <p class="text-muted sg-note">Every block has a <code>theme</code> field. These are the only options.</p>
  </Section>
  {
    themes.map((t) => (
      <Section theme={t} spacing="small">
        <div class="sg-theme">
          <code>theme-{t}</code>
          <Button link={sampleLink('Button')} />
          <Button link={sampleLink('Secondary', 'secondary')} />
        </div>
      </Section>
    ))
  }

  <Section spacing="small">
    <h2 class="heading-style-h3">Blocks</h2>
    <p class="text-muted sg-note">
      Shown with sample data. Case study slider, logo strip, team grid and post grid render CMS content
      and appear on real pages.
    </p>
  </Section>

  <Hero
    eyebrow="Block: hero (size: large)"
    heading="We build brands people remember"
    text="A strategy-led studio for ambitious teams."
    ctas={[sampleLink('Start a project'), sampleLink('See our work', 'secondary')]}
    level="h2"
  />
  <Hero eyebrow="Block: hero (size: compact, theme: gold)" heading="About us" size="compact" theme="gold" level="h2" />
  <FeatureGrid
    eyebrow="Block: featureGrid"
    heading="What we do"
    intro="Three to four short items work best."
    items={[
      {_key: '1', title: 'Strategy', text: 'Positioning, messaging and research.'},
      {_key: '2', title: 'Design', text: 'Identity, websites and campaigns.'},
      {_key: '3', title: 'Growth', text: 'Performance, CRO and analytics.', link: sampleLink('Learn more', 'text')},
    ]}
    theme="ivory"
  />
  <SplitMedia
    eyebrow="Block: splitMedia"
    heading="Text next to an image"
    body={sampleText('The image can sit on the left or right. In the CMS the image is required.')}
    ctas={[sampleLink('Read more', 'secondary')]}
  />
  <RichTextSection
    heading="Block: richTextSection"
    body={sampleText('Long-form text at reading width. Supports headings, lists, quotes, links and inline images.')}
    theme="ivory"
  />
  <FaqList
    heading="Block: faqList"
    faqs={[
      {_id: '1', question: 'How long does a project take?', answer: 'Most projects take 6–10 weeks.'},
      {_id: '2', question: 'Do you work with startups?', answer: 'Yes, from seed stage onwards.'},
    ]}
  />
  <CtaBanner
    heading="Block: ctaBanner"
    text="Default theme is coal."
    ctas={[sampleLink('Get in touch'), sampleLink('Our work', 'secondary')]}
  />
</BaseLayout>

<style>
  .sg-intro {
    max-width: 40rem;
    margin-top: var(--space-5);
  }
  .sg-title {
    margin-bottom: var(--space-7);
  }
  .sg-note {
    margin-top: var(--space-3);
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--fs-small);
  }
  .sg-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }
  .sg-swatches li {
    display: grid;
    gap: var(--space-2);
  }
  .sg-swatch {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-small);
    border: 1px solid var(--border);
  }
  .sg-stack {
    display: grid;
    gap: var(--space-7);
  }
  .sg-row {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .sg-buttons,
  .sg-theme {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }
  .sg-theme code {
    min-width: 9rem;
  }
</style>
