---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/ui/Section.astro'
import Button from '@/components/ui/Button.astro'
---

<BaseLayout seo={{title: 'Page not found', noIndex: true}}>
  <Section spacing="large" width="small">
    <div class="not-found">
      <p class="eyebrow">404</p>
      <h1 class="heading-style-h1">This page doesn't exist.</h1>
      <p class="text-size-large text-muted">It may have moved, or the link is wrong.</p>
      <Button href="/" label="Back to home" />
    </div>
  </Section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
</style>
