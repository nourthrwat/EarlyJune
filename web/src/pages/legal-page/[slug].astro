---
/** Legal pages (privacy policy etc). Webflow URL: /legal-page/<slug> */
import BaseLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/ui/Section.astro'
import RichText from '@/components/ui/RichText.astro'
import {sanityFetch} from '@/lib/sanity'
import {LEGAL_SLUGS_QUERY, LEGAL_QUERY} from '@/lib/queries'
import type {Seo} from '@/lib/types'

export async function getStaticPaths() {
  const slugs = (await sanityFetch<string[] | null>(LEGAL_SLUGS_QUERY)) ?? []
  return slugs.map((slug) => ({params: {slug}}))
}

type Legal = {title: string; body?: unknown[]; updatedOn?: string; seo: Seo}

const doc = await sanityFetch<Legal | null>(LEGAL_QUERY, {slug: Astro.params.slug})
if (!doc) return Astro.redirect('/404')
---

<BaseLayout seo={doc.seo} fallbackTitle={doc.title}>
  <Section width="small" spacing="large">
    <h1 class="heading-style-h1">{doc.title}</h1>
    {doc.updatedOn && <p class="text-muted legal-date">Last updated {doc.updatedOn}</p>}
    <RichText value={doc.body} class="legal-body" />
  </Section>
</BaseLayout>

<style>
  .legal-date {
    margin-top: var(--space-4);
  }
  :global(.legal-body) {
    margin-top: var(--space-8);
    font-size: var(--fs-regular);
  }
</style>
